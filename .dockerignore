# ── Never copy these into the Docker image ────────────────────────────────────

# Virtual environment — hundreds of MB, not needed (pip installs inside image)
venv/
.venv/
env/

# Python bytecode — regenerated automatically
__pycache__/
*.pyc
*.pyo
*.pyd

# Secrets — injected at runtime via environment variables
.env

# Version control
.git/
.gitignore

# Dev tooling
.vscode/
.idea/
*.md

# Test files
tests/

# Local database (fresh one created in container)
openenv.db

# OS junk
.DS_Store
Thumbs.db
